{
  "entities": {
    "SubMerchant": {
      "title": "SubMerchant",
      "description": "Registered telecom agent or reseller outlet earning commissions on bundles and airtime.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique agent identifier e.g. AGT-ACC-01"
        },
        "name": {
          "type": "string",
          "description": "Full name of the agent operator"
        },
        "businessName": {
          "type": "string",
          "description": "Business or outlet name"
        },
        "phone": {
          "type": "string",
          "description": "Ghana phone number"
        },
        "email": {
          "type": "string",
          "description": "Agent contact email"
        },
        "momoNumber": {
          "type": "string",
          "description": "Mobile Money withdrawal phone number"
        },
        "momoNetwork": {
          "type": "string",
          "enum": ["MTN", "TELECEL", "AIRTELTIGO"],
          "description": "Mobile Money wallet network"
        },
        "commissionRate": {
          "type": "number",
          "description": "Commission percentage (e.g. 8 for 8%)"
        },
        "totalCommissionEarned": {
          "type": "number",
          "description": "Total commission earned to date in GHS"
        },
        "availableCommissionBalance": {
          "type": "number",
          "description": "Available balance eligible for payout in GHS"
        },
        "totalSalesVolume": {
          "type": "number",
          "description": "Total sales volume facilitated in GHS"
        },
        "totalOrdersCount": {
          "type": "number",
          "description": "Count of successful orders processed"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "pending"],
          "description": "Current status of agent account"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "name", "businessName", "phone", "commissionRate", "status", "createdAt"]
    },
    "TelecomOrder": {
      "title": "TelecomOrder",
      "description": "Purchased data bundle or airtime transaction.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order ID e.g. ORD-GH-12345"
        },
        "customerPhone": {
          "type": "string",
          "description": "Recipient Ghana mobile phone number"
        },
        "network": {
          "type": "string",
          "enum": ["MTN", "TELECEL", "AIRTELTIGO"],
          "description": "Telecom carrier"
        },
        "productType": {
          "type": "string",
          "enum": ["DATA", "AIRTIME"],
          "description": "Product category"
        },
        "packageName": {
          "type": "string",
          "description": "Description of package purchased"
        },
        "amountGhs": {
          "type": "number",
          "description": "Order price in GHS"
        },
        "commissionGhs": {
          "type": "number",
          "description": "Attributed agent commission amount"
        },
        "agentId": {
          "type": "string",
          "description": "Referral agent ID or DIRECT"
        },
        "agentName": {
          "type": "string",
          "description": "Agent name or Direct Customer"
        },
        "agentPhone": {
          "type": "string",
          "description": "Agent phone number"
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "PENDING", "FAILED", "RETRYING"],
          "description": "Fulfillment status"
        },
        "deliveryMessage": {
          "type": "string",
          "description": "Gateway delivery status note"
        },
        "hubtelTransactionId": {
          "type": "string",
          "description": "Hubtel carrier reference ID"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of transaction"
        }
      },
      "required": ["id", "customerPhone", "network", "productType", "packageName", "amountGhs", "commissionGhs", "status", "createdAt"]
    },
    "CommissionRecord": {
      "title": "CommissionRecord",
      "description": "Granular commission ledger entry credited to an agent.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Commission ID e.g. COMM-ORD-123"
        },
        "orderId": {
          "type": "string",
          "description": "Associated order ID"
        },
        "agentId": {
          "type": "string",
          "description": "Credited agent ID"
        },
        "amountGhs": {
          "type": "number",
          "description": "Commission credited in GHS"
        },
        "orderTotalGhs": {
          "type": "number",
          "description": "Associated order total in GHS"
        },
        "ratePercent": {
          "type": "number",
          "description": "Commission rate applied"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of commission credit"
        }
      },
      "required": ["id", "orderId", "agentId", "amountGhs", "orderTotalGhs", "ratePercent", "createdAt"]
    },
    "PayoutRecord": {
      "title": "PayoutRecord",
      "description": "Mobile money withdrawal payout record for sub-merchant commission balance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payout reference ID e.g. PAYOUT-12345"
        },
        "agentId": {
          "type": "string",
          "description": "Recipient agent ID"
        },
        "amountGhs": {
          "type": "number",
          "description": "Withdrawn amount in GHS"
        },
        "status": {
          "type": "string",
          "enum": ["PAID", "PENDING", "FAILED"],
          "description": "Payout settlement status"
        },
        "momoNumber": {
          "type": "string",
          "description": "Recipient Mobile Money phone number"
        },
        "momoNetwork": {
          "type": "string",
          "enum": ["MTN", "TELECEL", "AIRTELTIGO"],
          "description": "Mobile Money network"
        },
        "requestedAt": {
          "type": "string",
          "description": "ISO timestamp of request"
        },
        "processedAt": {
          "type": "string",
          "description": "ISO timestamp of processing"
        }
      },
      "required": ["id", "agentId", "amountGhs", "status", "momoNumber", "momoNetwork", "requestedAt"]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": "SubMerchant",
      "description": "Master sub-merchant agent profile records"
    },
    "/agents/{agentId}/orders/{orderId}": {
      "schema": "TelecomOrder",
      "description": "Orders credited to this specific agent"
    },
    "/agents/{agentId}/commissions/{commissionId}": {
      "schema": "CommissionRecord",
      "description": "Commission ledger entries for this agent"
    },
    "/agents/{agentId}/payouts/{payoutId}": {
      "schema": "PayoutRecord",
      "description": "Mobile money commission cashout records for this agent"
    },
    "/orders/{orderId}": {
      "schema": "TelecomOrder",
      "description": "Global telecom bundle and airtime orders"
    },
    "/payouts/{payoutId}": {
      "schema": "PayoutRecord",
      "description": "Global commission cashout records"
    }
  }
}
