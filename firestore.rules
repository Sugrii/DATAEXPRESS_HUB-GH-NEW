rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agents collection and sub-collections (orders, commissions, payouts)
    match /agents/{agentId} {
      allow read, write: if true;

      match /{subpath=**} {
        allow read, write: if true;
      }
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Payouts collection
    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
