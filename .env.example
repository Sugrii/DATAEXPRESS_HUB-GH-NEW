# HUBTEL ROUTING KEYS: For Ghana Direct Telco Data Bundle & Airtime instant fulfillment API
HUBTEL_CLIENT_ID="hubtel_client_id_..."
HUBTEL_CLIENT_SECRET="hubtel_client_secret_..."
HUBTEL_MERCHANT_ACCOUNT_NUMBER="2010..."

# ADMIN_SECURITY: Master Admin secret key for platform administration & payout approval
ADMIN_SECRET_KEY="gh_telecom_admin_secret_2026"
